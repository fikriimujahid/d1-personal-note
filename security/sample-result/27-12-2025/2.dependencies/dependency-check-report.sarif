uri": "file://\/src\/frontend\/package-lock.json?\/zod:4.2.1"},"properties": {"license": "MIT","id1114": "pkg:npm\/zod@4.2.1","vid48": "cpe:2.3:a:zod:zod:4.2.1:*:*:*:*:*:*:*"}}],"results": [ {"ruleId": "CVE-2025-64718","level": "warning","message": {"text": "CVE-2025-64718 - js-yaml is a JavaScript YAML parser and dumper. In js-yaml 4.1.0 and below, it's possible for an attacker to modify the prototype of the result of a parsed yaml document via prototype pollution (`__proto__`). All users who parse untrusted yaml documents may be impacted. The problem is patched in js-yaml 4.1.1. Users can protect against this kind of attack on the server by using `node --disable-proto=delete` or `deno` (in Deno, pollution protection is on by default)."},"partialFingerprints": {"vulnerabilityHash": "5d63f459de2ae376674e5669815b6ae4"},"locations": [{"physicalLocation": {"artifactLocation": {"uri": "file://\/src\/api\/.aws-sam\/build\/ReadNotesFunction\/package-lock.json?\/js-yaml:3.14.2","index": 837 }},"logicalLocations": [{"fullyQualifiedName": "pkg:npm\/js-yaml@3.14.2"}]}]}]}]}